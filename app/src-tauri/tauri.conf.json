{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Guarita",
  "version": "0.2.2",
  "identifier": "com.guarita.app",
  "build": {
    "beforeDevCommand": "npm run vite:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run vite:build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "painel",
        "title": "Guarita",
        "url": "index.html",
        "width": 960,
        "height": 680,
        "minWidth": 520,
        "minHeight": 420,
        "center": true,
        "resizable": true,
        "decorations": true,
        "alwaysOnTop": false,
        "visible": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost https://guarita.pages.dev https://render.albiononline.com ws://localhost:8099",
        "img-src": "'self' data: https://render.albiononline.com",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self'",
        "font-src": "'self' data:",
        "media-src": "'self' data:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-src": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost https://guarita.pages.dev https://render.albiononline.com ws://localhost:8099 ws://localhost:1420 http://localhost:1420",
        "img-src": "'self' data: https://render.albiononline.com",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self'",
        "font-src": "'self' data:",
        "media-src": "'self' data:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-src": "'none'"
      },
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Guarita",
    "category": "Utility",
    "shortDescription": "Companheiro em PT-BR e espanhol para Albion Online",
    "longDescription": "Guarita no PC: preço rápido, relógio do servidor, dossiê, alertas e despertador locais com voz em português ou espanhol. Só funciona com o app aberto e não toca no processo do jogo. Opcional e desligada por padrão: captura passiva do tráfego do próprio jogador (com Npcap) para mostrar a sua sessão, sem enviar nada ao jogo. Não afiliado à Sandbox Interactive.",
    "copyright": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["PortugueseBR", "Spanish"],
        "installMode": "currentUser"
      },
      "wix": {
        "language": "pt-BR"
      }
    }
  }
}
